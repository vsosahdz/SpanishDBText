# --- Secrets -----------------------------------------------------------------
# Never commit .env: it holds API keys. Use .env.example as the template.
.env
.env.*
!.env.example

# --- Python ------------------------------------------------------------------
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/

# --- Expanded data -----------------------------------------------------------
# The release ships compressed archives under corpus/, which ARE tracked.
# scripts/unpack_corpus.py expands them into output/ and data/, and those
# expanded copies must stay untracked: they are the same bytes, ~520 MB larger.
# The `!…/**/` lines re-include the directories themselves. Without them git
# never descends into an excluded directory and the .gitkeep negation below
# silently has no effect.
output/**
!output/**/
!output/**/.gitkeep
data/**
!data/**/
!data/**/.gitkeep

# Timestamped results of metrics/run_metrics.py; the published copies are in corpus/metrics/
metrics/output/

# Figures regenerated by notebook 06
figures/*
!figures/.gitkeep

# --- OS and editors ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
