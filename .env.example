# =============================================================================
#  Pipeline configuration  -  copy this file to .env and fill in your own values
# =============================================================================
#
#   cp .env.example .env
#
#  .env is listed in .gitignore and must never be committed: it holds API keys.
#  Every model role below is written as  provider:model  so that models can be
#  swapped without touching any code. Supported providers: azure, foundry, ollama.
#
#  The values shown here are the ones used for the run reported in the paper,
#  with endpoints and keys removed. Deployment names are specific to our Azure
#  subscription; replace them with your own.
#
#  See docs/configuration.md for what each variable does.
# =============================================================================


# --- Legacy single-provider fallback -----------------------------------------
# Used only if no TRANSLATION_MODEL_* is set. Leave as is for normal runs.
LLM_PROVIDER=ollama


# --- Ollama (local models) ---------------------------------------------------
# Started by docker-compose.yml. Needed only if a role uses provider "ollama".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b


# --- Azure OpenAI ------------------------------------------------------------
# Endpoint looks like: https://<your-resource>.openai.azure.com/
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_API_VERSION=2025-01-01-preview


# --- Azure AI Foundry (serverless deployments) -------------------------------
# One endpoint/key pair per model family. The run used Mistral Large only;
# the agent also recognises FOUNDRY_CLAUDE_*, FOUNDRY_DEEPSEEK_* and
# FOUNDRY_LLAMA_* if you point a role at those families.
FOUNDRY_MISTRAL_ENDPOINT=
FOUNDRY_MISTRAL_KEY=


# --- Stage 3: translation models ---------------------------------------------
# One to four models translate every entry in parallel. Use architectures from
# different families: three models from the same family make similar mistakes
# and the consensus stage then adds little. Leave a slot empty to use fewer.
TRANSLATION_MODEL_1=azure:<your-gpt-4.1-mini-deployment>
TRANSLATION_MODEL_2=foundry:<your-mistral-large-deployment>
TRANSLATION_MODEL_3=ollama:qwen3.5:9b


# --- Stage 4: reviewer -------------------------------------------------------
# Merges the candidates into the consensus translation. This is the most
# demanding role and, at 77% of total spend, by far the most expensive one.
REVIEWER_MODEL=azure:<your-gpt-4.1-deployment>


# --- Stage 5: evaluator ------------------------------------------------------
# Scores the consensus translation against the anchored scoring guide, with no
# human reference translation.
EVALUATOR_MODEL=azure:<your-gpt-4.1-mini-deployment>


# --- Model parameters --------------------------------------------------------
# TEMPERATURE  0.2 keeps output nearly deterministic while allowing slight
#              variation; 0 would make runs identical, higher values add
#              randomness that a fidelity task does not want.
# NUM_CTX      context window, in tokens.
# NUM_PREDICT  maximum output tokens for translation and review. Evaluation and
#              metadata calls use a fixed 1,024 and ignore this value.
TEMPERATURE=0.2
NUM_CTX=32768
NUM_PREDICT=8192
